# AI AppSec Platform — environment variables
# Copy this file to .env and fill in real values before running the server.
# .env is git-ignored and must never be committed.

# ── Groq AI ──────────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── API key auth ─────────────────────────────────────────────────────────────
# All /api/* and /findings/* endpoints require this key in the X-API-Key header.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset (or set API_KEY_DISABLED=true) to skip auth in local dev.
API_KEY=

# Set to true ONLY for automated tests / local dev without auth.
# Must be unset or false in any deployed environment.
API_KEY_DISABLED=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default (when unset): http://localhost:3000
# Production example: CORS_ORIGINS=https://appsec.yourdomain.com
CORS_ORIGINS=http://localhost:3000
