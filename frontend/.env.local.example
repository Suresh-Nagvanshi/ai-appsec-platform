# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.

# URL of the running FastAPI backend (server-only).
BACKEND_API_URL=http://localhost:8000

# Server-only API key that matches API_KEY in backend/.env.
# Generate a matching key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank (or omit) when API_KEY_DISABLED=true is set on the backend.
BACKEND_API_KEY=
